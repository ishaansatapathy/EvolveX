# Evolvex — staging environment template (#45)
# Same shape as production with staging URLs/secrets.

NODE_ENV=production
PORT=8000

BASE_URL=https://staging-api.example.com
CLIENT_URL=https://staging-app.example.com
API_INTERNAL_URL=https://staging-api.example.com
NEXT_PUBLIC_API_URL=/trpc

DATABASE_URL=
DATABASE_URL_UNPOOLED=

JWT_SECRET=
JWT_REFRESH_SECRET=

SIGNOZ_CLOUD_URL=
SIGNOZ_API_KEY=
SIGNOZ_WEBHOOK_SECRET=
SIGNOZ_WEBHOOK_PUBLIC_URL=https://staging-api.example.com/webhooks/signoz

OPENAI_API_KEY=
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

SKIP_ENV_VALIDATION=false

# After deploy:
# pnpm deploy:smoke https://staging-api.example.com
