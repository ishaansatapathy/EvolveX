# Evolvex — production environment (Railway API + Vercel Web)
# Copy values from local .env; replace URLs with production domains.

NODE_ENV=production
PORT=8000

# ── Replace with production URLs after deploy ──
BASE_URL=https://your-api.up.railway.app
CLIENT_URL=https://your-app.vercel.app
API_INTERNAL_URL=https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=/trpc

# ── Database (Neon Postgres — recommended) ──
# Pooled URL for API runtime (Railway/Vercel env):
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct URL for migrations (Railway build + local pnpm db:migrate):
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ── Auth ──
JWT_SECRET=
JWT_REFRESH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api-auth/google/callback

# ── SigNoz ──
SIGNOZ_CLOUD_URL=
SIGNOZ_API_KEY=
SIGNOZ_INGESTION_URL=https://ingest.in2.signoz.cloud
# RECOMMENDED in production (pnpm deploy:preflight warns if unset): without
# it evolvex-api never self-instruments with OTel — no dogfooding traces/logs,
# no self-observability alerts, and MCP-driven /investigations queries have
# nothing of Evolvex's own to show. Get one from SigNoz → Settings → Ingestion.
SIGNOZ_INGESTION_KEY=
SIGNOZ_DEFAULT_SERVICE_NAME=payments-svc
SIGNOZ_WEBHOOK_SECRET=
SIGNOZ_WEBHOOK_PUBLIC_URL=https://your-api.up.railway.app/webhooks/signoz
# Traces + metrics + logs all export by default once SIGNOZ_INGESTION_KEY is set.
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none

# ── OpenAI ──
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── GitHub ──
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
INVESTIGATION_OWNER_EMAIL=

# ── K8s / eBPF / feature-flag / CI-CD webhooks ──
# Multi-tenant by default: each workspace generates its own scoped secret from Settings → Connect
# signal webhooks (indexed hash lookup, 24h dual-secret rotation window — no shared secret across
# tenants). Leave these unset in a real multi-tenant deployment; they're only a legacy
# single-tenant/dev fallback for workspaces that haven't connected via the UI yet.
KUBERNETES_WEBHOOK_SECRET=
EBPF_WEBHOOK_SECRET=
FEATURE_FLAG_WEBHOOK_SECRET=
CICD_WEBHOOK_SECRET=

# Kubernetes Helm chart (Settings → Connect Kubernetes uses OCI in production)
# EVOLVEX_HELM_CHART_OCI=oci://ghcr.io/ishaansatapathy/evolvex-agent
# EVOLVEX_HELM_CHART_VERSION=0.1.0

# ── Slack self-service "Add to Slack" (Settings → Connect integrations) ──
# Create a Slack App at https://api.slack.com/apps with bot scope "incoming-webhook"
# and Redirect URL https://your-api.up.railway.app/integrations/slack/callback.
# Unset = Settings falls back to manual webhook-URL paste.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ── Optional OBI bridge (if running separately) ──
# OBI_BRIDGE_INTERVAL_SEC=60

# Production: do NOT skip validation
SKIP_ENV_VALIDATION=false

# Post-deploy verification (local or CI):
# pnpm deploy:smoke https://your-api.up.railway.app
