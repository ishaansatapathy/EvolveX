{
  "name": "evolvex",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "dotenv -- pnpm --parallel --filter web --filter @repo/api dev",
    "db:generate": "dotenv -- turbo db:generate",
    "db:migrate": "dotenv -- turbo db:migrate",
    "db:check": "dotenv -- turbo db:check --filter=@repo/database",
    "db:seed": "dotenv -- turbo db:seed",
    "db:up": "docker compose up -d postgresdb",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "signoz:seed": "dotenv -- pnpm exec tsx scripts/signoz-seed-demo.ts",
    "signoz:loadgen": "dotenv -- pnpm exec tsx scripts/signoz-loadgen.ts",
    "signoz:spike": "dotenv -- pnpm exec tsx scripts/signoz-loadgen.ts --spike",
    "signoz:p99": "dotenv -- pnpm exec tsx scripts/signoz-loadgen.ts --p99",
    "demo:incident": "dotenv -- pnpm exec tsx scripts/demo-incident.ts",
    "investigation:seed": "dotenv -- pnpm exec tsx scripts/investigation-seed.ts",
    "investigation:reassign": "dotenv -- pnpm exec tsx scripts/reassign-investigations.ts",
    "investigation:refresh": "dotenv -- pnpm exec tsx scripts/investigation-refresh.ts",
    "k8s:webhook-demo": "dotenv -- pnpm exec tsx scripts/k8s-webhook-demo.ts",
    "ebpf:webhook-demo": "dotenv -- pnpm exec tsx scripts/ebpf-webhook-demo.ts",
    "feature-flag:webhook-demo": "dotenv -- pnpm exec tsx scripts/feature-flag-webhook-demo.ts",
    "cicd:webhook-demo": "dotenv -- pnpm exec tsx scripts/cicd-webhook-demo.ts",
    "sdk:demo": "dotenv -- pnpm exec tsx scripts/sdk-demo.ts",
    "plugin:webhook-demo": "dotenv -- pnpm exec tsx scripts/plugin-webhook-demo.ts",
    "org:backfill": "dotenv -- pnpm exec tsx scripts/backfill-organizations.ts",
    "wiring:secrets": "pnpm exec tsx scripts/generate-wiring-secrets.ts",
    "wiring:check": "dotenv -- pnpm exec tsx scripts/wiring-check.ts",
    "benchmark:run": "dotenv -- pnpm exec tsx scripts/benchmark.ts",
    "deploy:preflight": "dotenv -- pnpm exec tsx scripts/deploy-preflight.ts",
    "deploy:smoke": "dotenv -- pnpm exec tsx scripts/deploy-smoke.ts",
    "clickhouse:apply-mvs": "dotenv -- pnpm exec tsx scripts/apply-clickhouse-mvs.ts",
    "docker:prod": "docker compose -f docker-compose.prod.yml up --build",
    "tunnel:refresh": "pnpm exec tsx scripts/tunnel-refresh.ts",
    "obi:up": "docker compose -f docker-compose.obi.yml up",
    "obi:bridge": "dotenv -- pnpm exec tsx scripts/obi-anomaly-bridge.ts"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
